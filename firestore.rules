rules_version = '2';
// Firebase 콘솔 > Firestore Database > 규칙 탭에 통째로 붙여넣고 [게시]
// 선생님마다 자기 방(rooms/선생님코드)만 고칠 수 있습니다.
// ★ "@dongin.escape" 는 js/config.js 의 idDomain 과 같아야 합니다.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isTeacher() { return signedIn() && request.auth.token.firebase.sign_in_provider == "password"; }
    function owns(room) { return isTeacher() && request.auth.token.email == room + "@dongin.escape"; }

    match /rooms/{room} {
      allow read: if signedIn();
      allow write: if owns(room);

      match /problems/{id} {
        allow read: if signedIn();
        allow write: if owns(room);
      }
      match /answerKeys/{id} {
        allow read, write: if owns(room);
      }
      match /players/{sid} {
        allow read: if signedIn();
        allow create, update: if signedIn() && sid.matches('^[0-9]{4,6}$');
        allow delete: if owns(room);
      }
    }
  }
}
